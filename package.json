{
  "name": "pr-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local dashboard and agent runner for GitHub pull requests",
  "bin": {
    "pr-manager": "server/cli.ts"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/main.ts",
    "check": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test 'test/**/*.test.ts'",
    "lock:strip": "node scripts/strip-lock.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.303",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
